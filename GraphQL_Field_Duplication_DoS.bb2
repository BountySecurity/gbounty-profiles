[
  {
    "profile_name": "GraphQL_Field_Duplication_DoS",
    "enabled": true,
    "scanner": "active",
    "author": "@bountysecurity",
    "steps": [
      {
        "request_type": "original",
        "reuse_cookie": false,
        "insertion_point": "same",
        "raw_request": "",
        "payloads": [
          "true,{\"query\":\"query{__typename\\n__typename\\n__typename\\n__typename\\n__typename\\n__typename\\n__typename\\n__typename\\n__typename\\n__typename\\n}\"}"
        ],
        "payloads_file": "",
        "payload_position": "replace",
        "change_http_request": false,
        "change_http_request_type": "post_to_get",
        "insertion_points": [
          "user_provided",
          "entire_body_json"
        ],
        "header_value": false,
        "new_headers": [],
        "match_replace": [],
        "encoder": [],
        "url_encode": false,
        "chars_to_url_encode": "",
        "greps_file": "",
        "grep": [
          "true,,Simple String,,\"__typename\":\"Query\"",
          "true,AND,Content Type,,application/json"
        ],
        "redir_type": "always",
        "max_redir": 5,
        "show_alert": "always",
        "issue_name": "GraphQL Field Duplication",
        "issue_severity": "Medium",
        "issue_confidence": "Certain",
        "issue_detail": "The GraphQL endpoint allows excessive duplication of fields without restrictions. This could be exploited for denial of service attacks by crafting queries with thousands of duplicate fields to exhaust server resources.",
        "remediation_detail": "Implement query complexity analysis and limits to prevent resource exhaustion. Consider using tools like graphql-query-complexity to assign complexity values to fields and reject queries that exceed a defined threshold.",
        "issue_background": "",
        "remediation_background": ""
      }
    ],
    "Tags": [
      "GraphQL",
      "DoS",
      "All"
    ]
  }
]