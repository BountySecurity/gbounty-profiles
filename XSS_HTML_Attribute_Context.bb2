          "true,\" autofocus onfocus=\"alert(1)",
          "true,\" onload=\"alert(1)",
          "true,\" onerror=\"alert(1)",
          "true,\" onclick=\"alert(1)",
          "true,' onmouseover='alert(1)",
          "true,' onfocus='alert(1)",
          "true,' onload='alert(1)",
          "true,' onerror='alert(1)",
          "true,' onclick='alert(1)"
        ],
