          "true,javascript:void(document.documentElement.dataset.testxss='found')",
          "true,data:text/html;base64,PHNjcmlwdD5kb2N1bWVudC5kb2N1bWVudEVsZW1lbnQuZGF0YXNldC50ZXN0eHNzPSdmb3VuZCc8L3NjcmlwdD4=",
          "true,\"><img src=x onerror=document.documentElement.dataset.testxss='found'>//",
          "true,'><img src=x onerror=document.documentElement.dataset.testxss='found'>//"
        ],
        "payloads_file": "",
        "payload_position": "replace",
        "change_http_request": false,
        "change_http_request_type": "post_to_get",
        "insertion_points": [
          "param_url"
