[
  {
    "profile_name": "GraphQL_Batching",
    "enabled": true,
    "scanner": "active",
    "author": "@bountysecurity",
    "steps": [
      {
        "request_type": "original",
        "reuse_cookie": false,
        "insertion_point": "same",
        "raw_request": "",
        "payloads": [
          "true,[{\"query\":\"{__typename}\"},{\"query\":\"{__typename}\"},{\"query\":\"{__typename}\"}]"
        ],
        "payloads_file": "",
        "payload_position": "replace",
        "change_http_request": false,
        "change_http_request_type": "post_to_get",
        "insertion_points": [
          "user_provided",
          "entire_body_json"
        ],
        "header_value": false,
        "new_headers": [],
        "match_replace": [],
        "encoder": [],
        "url_encode": false,
        "chars_to_url_encode": "",
        "greps_file": "",
        "grep": [
          "true,,Regex,,\\[\\{\"data\":\\{\"__typename\":[^}]+\\}\\},\\{\"data\":",
          "true,AND,Content Type,,application/json"
        ],
        "redir_type": "always",
        "max_redir": 5,
        "show_alert": "always",
        "issue_name": "GraphQL Batching Enabled",
        "issue_severity": "Medium",
        "issue_confidence": "Certain",
        "issue_detail": "The GraphQL endpoint allows query batching, which enables multiple operations to be sent and processed in a single request. This could be exploited for rate limit bypassing, amplification attacks, or to hide malicious queries among legitimate ones.",
        "remediation_detail": "Disable query batching if it's not necessary for your application. If batching is required, implement per-operation rate limiting and ensure that authentication and authorization are properly checked for each operation in the batch.",
        "issue_background": "",
        "remediation_background": ""
      }
    ],
    "Tags": [
      "GraphQL",
      "DoS",
      "All"
    ]
  }
]