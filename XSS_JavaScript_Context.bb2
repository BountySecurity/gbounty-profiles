          "true,OR,Regex,,<script[^>]*>([^<]*?xss_prefix_x\\\\\\\\\";alert\\(1\\);[^<]*?)</script>",
          "true,OR,Regex,,<script[^>]*>([^<]*?xss_prefix_x\\\\\\\\\\\\\\\\\";alert\\(1\\);[^<]*?)</script>",
          "true,OR,Regex,,<script[^>]*>([^<]*?xss_prefix_x';prompt\\(1\\);[^<]*?)</script>",
