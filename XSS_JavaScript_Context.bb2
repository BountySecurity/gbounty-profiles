          "true,OR,Regex,,<script[^>]*>([^<]*?xss_prefix_x\\\\\\\\\\\\\\\\';print\\(1\\);[^<]*?)</script>",
          "true,OR,Regex,,<script[^>]*>([^<]*?xss_prefix_x\";print\\(1\\);[^<]*?)</script>",
